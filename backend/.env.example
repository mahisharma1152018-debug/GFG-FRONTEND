PORT=5000
MONGODB_URI=
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=
SYNC_SECRET=

# Account (organization or user) whose repos you want to track
GITHUB_OWNER=gfg-rbu
GITHUB_OWNER_TYPE=organization

# Which repos to track:
#   *                        -> every repo in the account (default, auto-discovers new repos)
#   repo1,repo2,owner/repo3  -> only these
GITHUB_REPOS=*

# Optional
GITHUB_EXCLUDE_REPOS=
GITHUB_INCLUDE_FORKS=false
GITHUB_INCLUDE_ARCHIVED=false

# Background sync every N minutes (0 = disable). Webhooks give instant updates,
# this is the safety net that guarantees nothing is ever missed.
SYNC_INTERVAL_MINUTES=10

# OAuth login (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=
AUTH_SUCCESS_REDIRECT=/
# Frontend origin used after GitHub OAuth callback (must be an allowed CORS origin).
FRONTEND_URL=http://localhost:5173

# Browser frontend origin(s) allowed to send the login cookie (comma separated).
# Leave empty if the frontend is served from the same origin as the API.
CORS_ORIGIN=http://localhost:5173
# Login session lifetime in days (default 7)
SESSION_TTL_DAYS=7

# Public API JSON cache TTL (seconds)
JSON_CACHE_TTL_SECONDS=60
# Maximum number of cached responses kept on disk
JSON_CACHE_MAX_ENTRIES=250
# Maximum serialized cache file size (bytes)
JSON_CACHE_MAX_BYTES=5242880
